{
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "packages/web/public",
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/markets", "destination": "/index.html" },
    { "source": "/markets/:path*", "destination": "/index.html" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/protocol", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
