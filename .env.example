# Network and safety
TEMPO_NETWORK=testnet
TEMPO_DRY_RUN=true
TEMPO_PAUSED=false
TEMPO_VENUE_ID=

# Two distinct Shannon-funded keys are required for live writes.
TEMPO_KEY_MAKER=
TEMPO_KEY_TAKER=

# Optional endpoint overrides. Defaults are the verified official endpoints.
# If Somnia's official RPC (https://api.infra.testnet.somnia.network) is down/502,
# use Thirdweb's public Somnia testnet RPC: https://50312.rpc.thirdweb.com
TEMPO_RPC_URL=
TEMPO_WS_RPC_URL=
TEMPO_INDEXER_URL=
TEMPO_EXPLORER_URL=

# Agent scope and journal
TEMPO_ASSETS=BTC,ETH
TEMPO_JOURNAL_DIR=journal
# Local-only dashboard bind. Remote exposure requires an authenticated TLS proxy.
TEMPO_HTTP_HOST=127.0.0.1
# Comma-separated exact browser origins allowed to read the Azure API/SSE stream.
# Example: https://tempo.vercel.app,https://tempo.example.com
TEMPO_WEB_ORIGINS=

# Optional report narrative. Reports are complete and deterministic without it.
# Optional report narrative provider (never used for trading or risk decisions).
# TEMPO_LLM_API_KEY=
# TEMPO_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# TEMPO_LLM_MODEL=gemini-2.5-flash
# Explicit opt-in only: enables the MCP live place_order tool.
TEMPO_MCP_WRITES=false

# Risk policy
TEMPO_QUOTE_SIZE=25
TEMPO_MAX_NET_INVENTORY=60
TEMPO_MAX_GROSS_INVENTORY=120
TEMPO_FIRM_CAPITAL_CAP=2000
TEMPO_MAX_ORDER_COLLATERAL=60
TEMPO_MAX_OPEN_ORDERS=8
TEMPO_MAX_WINDOW_LOSS=150
TEMPO_MIN_LEFT_MAKER=0
TEMPO_MIN_LEFT_TAKER=5
TEMPO_TAKER_EDGE=0.04
TEMPO_HALF_SPREAD=0.03
TEMPO_HALF_SPREAD_MIN=0.006
